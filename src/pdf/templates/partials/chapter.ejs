<section class="chapter page-break" id="ch-<%= chapter.id %>">
  <div class="chapter-num">
    <svg class="chapter-star" width="10" height="10" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2l2.9 6.9L22 9.3l-5.5 4.8L18 21l-6-4-6 4 1.5-6.9L2 9.3l7.1-.4L12 2z" fill="#c7a13a"/>
    </svg>
    第 <%= String(chapter.id).padStart(2,'0') %> 章
  </div>
  <h2><%= chapter.title %></h2>
  <% var keywords = getChapterKeywords(chapter.id, engine); %>
  <% if (keywords.length) { %>
  <div class="chapter-keywords">
    <% keywords.forEach(function(k) { %><span class="kw-chip"><%= k %></span><% }) %>
  </div>
  <% } %>
  <%- renderBody(chapter.text) %>
  <% if (chapter.id === 17) { %>
  <div class="quest-card avoid-break">
    <div class="quest-card-ttl">📱 오늘부터 실천할 개운 체크리스트</div>
    <ul class="quest-list">
      <% buildOhaengQuest(engine.yongshin.final.main).forEach(function(item) { %>
      <li><span class="quest-box"></span><%= item %></li>
      <% }) %>
    </ul>
    <p class="quest-hint">이 화면을 캡처해두고 매일 확인해보세요.</p>
  </div>
  <% } %>
  <% if (chapter.id === 18) { %>
  <p class="disclaimer">사주는 통계적 경향이자 참고이며, 인생은 본인의 선택으로 바뀝니다.</p>
  <% } %>
</section>
<% if (chapter.id === 7 && daewoonRows.length) { %>
<% const highest = daewoonRows.reduce((best, row) => row.score > best.score ? row : best); %>
<% const currentYear = new Date().getFullYear(); %>
<% const matchingIndex = daewoonRows.findIndex(function(row, index) { return row.year <= currentYear && (index === daewoonRows.length - 1 || daewoonRows[index + 1].year > currentYear); }); %>
<% const currentIndex = matchingIndex < 0 ? 0 : matchingIndex; %>
<% const currentRow = daewoonRows[currentIndex]; %>
<% const nextRow = daewoonRows[currentIndex + 1]; %>
<% const currentLabel = currentYear < daewoonRows[0].year ? '첫 대운 구간' : currentYear >= currentRow.year + 10 && !nextRow ? '마지막 표시 구간' : `${currentYear}년 현재 적용 구간`; %>
<section class="daewoon-sheet page-break">
  <div class="daewoon-inner">
    <div class="eyebrow">LIFE FLOW · 10 YEARS</div>
    <h2>10년씩 바뀌는 대운의 흐름</h2>
    <p class="daewoon-lead">이 그래프는 시기별 기운이 이 명식의 용신 <b><%= engine.yongshin.final.main %></b>과 맺는 관계를 비교한 참고 자료입니다.</p>
    <div class="daewoon-summary avoid-break">
      <div><small><%= currentLabel %></small><strong><%= currentRow.age %>세부터 · <%= currentRow.score %>점</strong></div>
      <% if (nextRow) { %><div><small>다음 10년 구간</small><strong><%= nextRow.age %>세부터 · <%= nextRow.score %>점</strong></div><% } else { %><div><small>표에서 가장 높은 구간</small><strong><%= highest.age %>세부터 · <%= highest.score %>점</strong></div><% } %>
    </div>
    <div class="daewoon-list">
      <% daewoonRows.forEach(function(row) { %>
      <div class="daewoon-row">
        <div class="period"><strong><%= row.age %>세~</strong><span><%= row.year %>년 시작 · <%= row.ganZhi %></span></div>
        <div class="track"><span class="<%= row.score === highest.score ? 'top' : '' %>" style="width:<%= row.score %>%"></span></div>
        <b class="score"><%= row.score %></b>
      </div>
      <% }) %>
    </div>
    <div class="daewoon-guide"><strong>이 숫자는 무엇을 뜻하나요?</strong><p>같은 기운이거나 도와주는 관계면 높고, 누르는 관계면 낮게 계산한 상대 비교값입니다. 실제 성공 확률이나 특정 사건의 예언은 아닙니다. 시작 나이는 절기와 출생 정보로 계산되며, 각 시기의 구체적인 선택은 16장 ‘평생 길흉 캘린더’에서 이어집니다.</p></div>
  </div>
</section>
<% } %>
