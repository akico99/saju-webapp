ANTHROPIC_API_KEY=
PORT=4500

# 세션 쿠키 서명 비밀키 — 반드시 운영에서는 임의의 긴 문자열로 교체
SESSION_SECRET=change-this-to-a-random-long-string

# 관리자(포인트 승인) 페이지 비밀번호 — /admin.html 로그인에 사용
ADMIN_PASSWORD=

# 포인트 충전 시 사용자에게 안내할 입금 계좌 (실제 본인 계좌로 채울 것)
DEPOSIT_ACCOUNT_INFO=[예: 카카오뱅크 000-0000-000000 (예금주명)]

# OAuth 콜백 URL 조립에 쓰는 서버 기준 주소 (배포 시 실제 도메인으로 교체)
BASE_URL=http://localhost:4500

# 네이버 로그인 (developers.naver.com에서 발급)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 토스페이먼츠 카드결제(상품 단건 결제, 결제위젯 연동 키). 시크릿이 live_로 시작하지 않으면 테스트 모드
# (결제창·승인·상품 생성은 실제와 같지만 청구 없음, 계정당 3건 한도). live_ 키를 넣으면 실결제.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
